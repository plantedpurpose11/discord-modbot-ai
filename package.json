{
  "name": "discord-ai-modbot",
  "version": "1.0.0",
  "description": "AI moderation bot for Discord",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test test/*.test.js",
