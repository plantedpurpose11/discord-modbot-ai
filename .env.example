DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Set for immediate registration in one server; omit for global commands.
DISCORD_GUILD_ID=
DATABASE_URL=postgresql://sentinel:change-this-local-password@localhost:5432/sentinel
REDIS_URL=redis://localhost:6379
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# For Ollama Cloud: URL=https://ollama.com, MODEL=gemma4:31b, then set your own key.
OLLAMA_API_KEY=
# Use a vision-capable local or cloud model for image scanning.
OLLAMA_VISION_MODEL=
# Defaults to 1 with an API key, 3 without. Allowed: 1-10.
OLLAMA_CONCURRENCY=
# Optional ClamAV daemon for malware signatures. No file is executed.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Optional. Claude is disabled per server until explicitly enabled.
ANTHROPIC_API_KEY=
# Choose a currently available Claude model from your Anthropic account.
CLAUDE_MODEL=
# Used by docker compose for the local database.
POSTGRES_PASSWORD=change-this-local-password
