    "dotenv": "^16.3.1",
    "htmlparser2": "^12.0.0",
    "ipaddr.js": "^2.5.0",
    "jsqr": "^1.4.0",
    "redis": "^4.6.13",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "prisma": "^5.8.0",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
